# Public address of the website, without a trailing slash. Used for the
# canonical URL, social sharing tags, Google structured data, robots.txt,
# sitemap.xml and llms.txt. Change it here (or set VITE_SITE_URL in Vercel)
# once SWEPT has its own domain, e.g. https://www.swept.com.au
VITE_SITE_URL=https://gippy-sweep123.vercel.app

# Cleaned by Swept (see docs/CLEANED-LAUNCH.md). Unset = served under /cleaned on
# the address above, noindex. Set these only at launch, with approval.
# VITE_CLEANED_BASE=
# VITE_CLEANED_SITE_URL=https://cleaned.swept.com.au
# VITE_CLEANED_NOINDEX=false

# Grounds by Swept (see docs/GROUNDS-LAUNCH.md). Unset = served under /grounds on
# the address above, noindex. Set these only at launch, with approval.
# VITE_GROUNDS_BASE=
# VITE_GROUNDS_SITE_URL=https://grounds.swept.com.au
# VITE_GROUNDS_NOINDEX=false
